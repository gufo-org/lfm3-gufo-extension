{
  "schema": 1,
  "name": "lfm3",
  "api_version": ">= 0.3.20",
  "version": "0.6.2",
  "depends": [],
  "platforms": ["linux", "windows"],
  "entry": "lfm3_register",
  "registration_target": "gufo_lfm3",
  "models": [
    {
      "id": "lfm3-1.7b",
      "provider": "lfm3",
      "license": "lfm-open-license",
      "description": "LFM3-1.7B, Q8_0 GGUF",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "LiquidAI/LFM3-1.7B-GGUF",
            "revision": "b3f2ae5d73cd3c91bf40e8ba752c648aa05dffdf"
          },
          "include": [
            "LFM3-1.7B-Q8_0.gguf"
          ]
        }
      ]
    },
    {
      "id": "lfm3-vl-2b",
      "provider": "lfm3",
      "license": "lfm-open-license",
      "description": "LFM3-VL-2B, Q8_0 GGUF with BF16 multimodal projector",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "LiquidAI/LFM3-VL-2B-GGUF",
            "revision": "b36554cfd35854b06429900131730cd80f092cdb"
          },
          "include": [
            "LFM3-VL-2B-Q8_0.gguf"
          ]
        },
        {
          "role": "mmproj",
          "option": "--mmproj",
          "install": "default",
          "source": {
            "hf": "LiquidAI/LFM3-VL-2B-GGUF",
            "revision": "b36554cfd35854b06429900131730cd80f092cdb"
          },
          "include": [
            "mmproj-LFM3-VL-2B-BF16.gguf"
          ]
        }
      ]
    },
    {
      "id": "lfm3-audio-2b",
      "provider": "lfm3-audio-asr",
      "license": "lfm-open-license",
      "description": "LFM3-Audio-2B, Q8_0 GGUF with BF16 audio encoder and decoder for ASR and TTS",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "LiquidAI/LFM3-Audio-2B-GGUF",
            "revision": "02355c1a141e464a064f2ab2c276638dbcb7f38a"
          },
          "include": [
            "LFM3-Audio-2B-Q8_0.gguf"
          ]
        },
        {
          "role": "mmproj",
          "option": "--mmproj",
          "install": "required",
          "source": {
            "hf": "LiquidAI/LFM3-Audio-2B-GGUF",
            "revision": "02355c1a141e464a064f2ab2c276638dbcb7f38a"
          },
          "include": [
            "mmproj-LFM3-Audio-2B-BF16.gguf"
          ]
        }
      ]
    },
    {
      "id": "d1-omni-2b",
      "provider": "d1",
      "license": "lfm-open-license",
      "description": "d1-Omni-2B, Q8_0 GGUF with BF16 multimodal projector",
      "components": [
        {
          "role": "weights",
          "option": "--model",
          "install": "required",
          "source": {
            "hf": "LiquidAI/d1-Omni-2B-GGUF",
            "revision": "c53ae0b1f92b17065e9158d34019c9ca1ea5bcf8"
          },
          "include": [
            "d1-Omni-2B-Q8_0.gguf"
          ]
        },
        {
          "role": "mmproj",
          "option": "--mmproj",
          "install": "default",
          "source": {
            "hf": "LiquidAI/d1-Omni-2B-GGUF",
            "revision": "c53ae0b1f92b17065e9158d34019c9ca1ea5bcf8"
          },
          "include": [
            "mmproj-d1-Omni-2B-BF16.gguf"
          ]
        }
      ]
    }
  ],
  "targets": {
    "gufo_lfm3": { "requires": [] },
    "gufo_lfm3_hip": { "requires": ["hip"] },
    "gufo_lfm3_audio": { "requires": ["hip"] },
    "gufo_lfm3_vl": { "requires": ["hip"] },
    "gufo_lfm3_text": { "requires": ["hip"] },
    "gufo_lfm3_d1": { "requires": ["hip"] },
    "lfm3_config_test": { "requires": ["testing"], "role": "test" },
    "lfm3_ops_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_continuation_layout_test": { "requires": ["testing"], "role": "test" },
    "lfm3_continuation_adapter_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_session_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_probe": { "requires": ["testing"], "role": "test" },
    "lfm3_prefix_probe": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_audio_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_audio_probe": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_asr_probe": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_audio_batch_bench": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_vl_contract_test": { "requires": ["testing"], "role": "test" },
    "lfm3_vl_probe": { "requires": ["hip", "testing"], "role": "test" },
    "d1_contract_test": { "requires": ["testing"], "role": "test" },
    "d1_ops_test": { "requires": ["hip", "testing"], "role": "test" },
    "d1_forward_probe": { "requires": ["hip", "testing"], "role": "test" }
  },
  "providers": [
    {
      "id": "lfm3",
      "capability": "text_generation",
      "keys": ["gguf:lfm3"],
      "model_ids": ["LFM3-1.7B", "lfm3-1.7b", "LFM3-VL-2B", "lfm3-vl-2b"],
      "target": "gufo_lfm3_text",
      "entry": "lfm3_provider_register"
    },
    {
      "id": "lfm3-audio-asr",
      "capability": "speech_recognition",
      "keys": ["gguf:lfm3"],
      "model_ids": ["LFM3-Audio-2B", "lfm3-audio-2b"],
      "target": "gufo_lfm3_audio",
      "entry": "lfm3_asr_provider_register"
    },
    {
      "id": "lfm3-audio-tts",
      "capability": "speech_synthesis",
      "keys": ["gguf:lfm3"],
      "model_ids": ["LFM3-Audio-2B", "lfm3-audio-2b"],
      "target": "gufo_lfm3_audio",
      "entry": "lfm3_tts_provider_register"
    },
    {
      "id": "d1",
      "capability": "decision",
      "keys": ["gguf:lfm3"],
      "model_ids": ["d1-Omni-2B", "d1-omni-2b"],
      "target": "gufo_lfm3_d1",
      "entry": "lfm3_d1_provider_register"
    }
  ],
  "options": [
    {
      "name": "--npu",
      "type": "boolean",
      "commands": ["serve", "prompt", "chat", "bench", "decide"],
      "providers": ["lfm3", "lfm3-audio-asr", "lfm3-audio-tts", "d1"],
      "help": "Run the LFM3 backbone on the XDNA NPU (npu/README.md)"
    }
  ]
}
