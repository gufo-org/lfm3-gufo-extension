{
  "schema": 1,
  "name": "lfm3",
  "api_version": ">= 0.3.4",
  "version": "0.6.0",
  "depends": [],
  "platforms": ["linux", "windows"],
  "entry": "lfm3_register",
  "registration_target": "gufo_lfm3",
  "targets": {
    "gufo_lfm3": { "requires": [] },
    "gufo_lfm3_hip": { "requires": ["hip"] },
    "gufo_lfm3_audio": { "requires": ["hip"] },
    "gufo_lfm3_vl": { "requires": ["hip"] },
    "gufo_lfm3_text": { "requires": ["hip"] },
    "gufo_lfm3_d1": { "requires": ["hip"] },
    "lfm3_config_test": { "requires": ["testing"], "role": "test" },
    "lfm3_ops_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_continuation_layout_test": { "requires": ["testing"], "role": "test" },
    "lfm3_continuation_adapter_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_session_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_probe": { "requires": ["testing"], "role": "test" },
    "lfm3_prefix_probe": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_audio_test": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_audio_probe": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_asr_probe": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_audio_batch_bench": { "requires": ["hip", "testing"], "role": "test" },
    "lfm3_vl_contract_test": { "requires": ["testing"], "role": "test" },
    "lfm3_vl_probe": { "requires": ["hip", "testing"], "role": "test" },
    "d1_contract_test": { "requires": ["testing"], "role": "test" },
    "d1_ops_test": { "requires": ["hip", "testing"], "role": "test" },
    "d1_forward_probe": { "requires": ["hip", "testing"], "role": "test" }
  },
  "providers": [
    {
      "id": "lfm3",
      "capability": "text_generation",
      "keys": ["gguf:lfm3"],
      "model_ids": ["LFM3-1.7B", "lfm3-1.7b", "LFM3-VL-2B", "lfm3-vl-2b"],
      "target": "gufo_lfm3_text",
      "entry": "lfm3_provider_register"
    },
    {
      "id": "lfm3-audio-asr",
      "capability": "speech_recognition",
      "keys": ["gguf:lfm3"],
      "model_ids": ["LFM3-Audio-2B", "lfm3-audio-2b"],
      "target": "gufo_lfm3_audio",
      "entry": "lfm3_asr_provider_register"
    },
    {
      "id": "lfm3-audio-tts",
      "capability": "speech_synthesis",
      "keys": ["gguf:lfm3"],
      "model_ids": ["LFM3-Audio-2B", "lfm3-audio-2b"],
      "target": "gufo_lfm3_audio",
      "entry": "lfm3_tts_provider_register"
    },
    {
      "id": "d1",
      "capability": "decision",
      "keys": ["gguf:lfm3"],
      "model_ids": ["d1-Omni-2B", "d1-omni-2b"],
      "target": "gufo_lfm3_d1",
      "entry": "lfm3_d1_provider_register"
    }
  ],
  "options": [
    {
      "name": "--npu",
      "type": "boolean",
      "commands": ["serve", "prompt", "chat", "bench", "decide"],
      "providers": ["lfm3", "lfm3-audio-asr", "lfm3-audio-tts", "d1"],
      "help": "Run the LFM3 backbone on the XDNA NPU from the model's .npu bundle (npu/README.md)"
    }
  ]
}
