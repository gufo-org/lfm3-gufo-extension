// Stream-only, three-slot weight ring.
pipeline.def<kernel> @gemv_stream_d3_col(%k: index, %rows: index, %records: index, %column: index) run(%x_arg: buffer, %w_arg: buffer, %y_arg: buffer) {
  %x_unique, %w_unique, %y_unique = buffer.assume.noalias %x_arg, %w_arg, %y_arg : buffer, buffer, buffer
  %x_buf, %w_buf, %y_buf = buffer.assume.alignment %x_unique, %w_unique, %y_unique {minimum_alignment = 64} : buffer, buffer, buffer
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %two = index.constant 2 : index
  %first = index.mul %column, %records : index
  %memory = pipeline.memory<workgroup>[%column, 3] : pool
  // Input: one resident slot.
  %x_bytes_i = index.mul %k, %two : index
  %x_bytes = index.cast %x_bytes_i : index to offset
  %x_storage = buffer.alloca<workgroup> pool(%memory) align(64) %x_bytes : buffer
  %x_slots = buffer.view %x_storage[%origin] : buffer -> view<1x[%k]xbf16>
  %x_channel = channel.bind<fifo> %x_slots, %c1 : view<1x[%k]xbf16>, index -> channel<tile<[%k]xbf16>>
  // Weights: two record slots of rows x k.
  %record_elements = index.mul %rows, %k : index
  %record_bytes_i = index.mul %record_elements, %two : index
  %c3 = index.constant 3 : index
  %ring_bytes_i = index.mul %record_bytes_i, %c3 : index
  %ring_bytes = index.cast %ring_bytes_i : index to offset
  %w_storage = buffer.alloca<workgroup> pool(%memory) align(64) %ring_bytes : buffer
  %w_slots = buffer.view %w_storage[%origin] : buffer -> view<3x[%rows]x[%k]xbf16>
  %w_channel = channel.bind<fifo> %w_slots, %c3 : view<3x[%rows]x[%k]xbf16>, index -> channel<tile<[%rows]x[%k]xbf16>>
  // Outputs: rows F32 values per record through a two-slot ring.
  %y_bytes_i = index.mul %rows, %c4 : index
  %y_ring_i = index.mul %y_bytes_i, %c2 : index
  %y_ring = index.cast %y_ring_i : index to offset
  %y_storage = buffer.alloca<workgroup> pool(%memory) align(64) %y_ring : buffer
  %y_slots = buffer.view %y_storage[%origin] : buffer -> view<2x[%rows]xf32>
  %y_channel = channel.bind<fifo> %y_slots, %c2 : view<2x[%rows]xf32>, index -> channel<tile<[%rows]xf32>>

  // Ingress: x once, then one regular weight loop that the compiler can move
  // into DMA descriptors (no per-record core work).
  pipeline.strand workers([%column, 2], [1, 1], [1, 1]) {
    %x_external = buffer.view %x_buf[%origin] : buffer -> view<[%k]xbf16>
    %x_write, %x_payload = channel.reserve %x_channel : channel<tile<[%k]xbf16>> -> (write<tile<[%k]xbf16>>, view<[%k]xbf16>)
    %x_copy = kernel.async.copy %x_external to %x_payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<[%k]xbf16> to view<[%k]xbf16> -> kernel.async.token
    %x_group = kernel.async.group %x_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %x_group {newer_groups = 0} : kernel.async.group
    channel.publish %x_write : write<tile<[%k]xbf16>>
    scf.for %record = [%c0 to %records step %c1] {
      %global_w = index.add %first, %record : index
      func.call @fill_weights(%k, %rows, %global_w, %record_bytes_i, %w_buf, %w_channel) : (index, index, index, index, buffer, channel<tile<[%rows]x[%k]xbf16>>)
    }
  }
  // Egress: drain each record's outputs independently of ingress.
  pipeline.strand workers([%column, 4], [1, 1], [1, 1]) {
    scf.for %record = [%c0 to %records step %c1] {
      %read, %payload = channel.acquire %y_channel : channel<tile<[%rows]xf32>> -> (read<tile<[%rows]xf32>>, view<[%rows]xf32>)
      %global_y = index.add %first, %record : index
      %out_index = index.mul %global_y, %y_bytes_i : index
      %out_offset = index.cast %out_index : index to offset
      %y_external = buffer.view %y_buf[%out_offset] : buffer -> view<[%rows]xf32>
      %y_copy = kernel.async.copy %payload to %y_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<[%rows]xf32> to view<[%rows]xf32> -> kernel.async.token
      %y_group = kernel.async.group %y_copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %y_group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<[%rows]xf32>>
    }
  }

  pipeline.strand workers([%column, 3], [1, 1], [1, 1]) {
    %x_read, %x_values = channel.acquire %x_channel : channel<tile<[%k]xbf16>> -> (read<tile<[%k]xbf16>>, view<[%k]xbf16>)
    scf.for %record = [%c0 to %records step %c1] {
      %read, %weights = channel.acquire %w_channel : channel<tile<[%rows]x[%k]xbf16>> -> (read<tile<[%rows]x[%k]xbf16>>, view<[%rows]x[%k]xbf16>)
      %y_write, %y_values = channel.reserve %y_channel : channel<tile<[%rows]xf32>> -> (write<tile<[%rows]xf32>>, view<[%rows]xf32>)
      channel.publish %y_write : write<tile<[%rows]xf32>>
      channel.release %read : read<tile<[%rows]x[%k]xbf16>>
    }
    channel.release %x_read : read<tile<[%k]xbf16>>
  }
}

