// Stream-only, weight ring in the column memory tile.
pipeline.def<kernel> @gemv_stream_mt_col(%k: index, %rows: index, %records: index, %column: index) run(%x_arg: buffer, %w_arg: buffer, %y_arg: buffer) {
  %x_unique, %w_unique, %y_unique = buffer.assume.noalias %x_arg, %w_arg, %y_arg : buffer, buffer, buffer
  %x_buf, %w_buf, %y_buf = buffer.assume.alignment %x_unique, %w_unique, %y_unique {minimum_alignment = 64} : buffer, buffer, buffer
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %two = index.constant 2 : index
  %first = index.mul %column, %records : index
  %memory = pipeline.memory<workgroup>[%column, 3] : pool
  // Input: one resident slot.
  %x_bytes_i = index.mul %k, %two : index
  %x_bytes = index.cast %x_bytes_i : index to offset
