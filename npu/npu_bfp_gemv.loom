  %groups = index.constant 128 : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %c5 = index.constant 5 : index
  %c6 = index.constant 6 : index
  %c7 = index.constant 7 : index
  pipeline.compose @bfp_b_col[%groups, %c0](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c1](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c2](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c3](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c4](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c5](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c6](%x, %w, %y) : [index, index](buffer, buffer, buffer)
  pipeline.compose @bfp_b_col[%groups, %c7](%x, %w, %y) : [index, index](buffer, buffer, buffer)
}

// Scalar oracle over the blocked BF16 layout: y[8g + r] = sum_j,c Wb[g][j][r][c] x[8j + c].
func.def inline @reference(%x: buffer, %w: buffer, %y: buffer, %groups: index) {
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %tiles = index.constant 256 : index
  %fzero = scalar.constant 0.0 : f32
  %xv = buffer.view %x[%origin] : buffer -> view<2048xbf16>
  %wv = buffer.view %w[%origin] : buffer -> view<[%groups]x256x8x8xbf16>
  %rows = index.mul %groups, %c8 : index
  %yv = buffer.view %y[%origin] : buffer -> view<[%rows]xf32>
  scf.for %g = [%c0 to %groups step %c1] {
    scf.for %r = [%c0 to %c8 step %c1] {
      %sum = scf.for %j = [%c0 to %tiles step %c1](%acc = %fzero : f32) -> (f32) {
        %inner = scf.for %c = [%c0 to %c8 step %c1](%a = %acc : f32) -> (f32) {
          %base = index.mul %j, %c8 : index
          %xi = index.add %base, %c : index
          %xb = view.load %xv[%xi] : view<2048xbf16> -> bf16
          %wb = view.load %wv[%g, %j, %r, %c] : view<[%groups]x256x8x8xbf16> -> bf16
          %xf = scalar.extf %xb : bf16 to f32
          %wf = scalar.extf %wb : bf16 to f32
          %next = scalar.fmaf %xf, %wf, %a : f32
          scf.yield %next : f32
        }
        scf.yield %inner : f32
      }
      %row8 = index.mul %g, %c8 : index
      %row = index.add %row8, %r : index
      view.store %sum, %yv[%row] : f32, view<[%rows]xf32>
    }
  }
  func.return
}

func.def @reference_m512(%x: buffer, %w: buffer, %y: buffer) {
  %groups = index.constant 64 : index
  func.call @reference(%x, %w, %y, %groups) : (buffer, buffer, buffer, index)
  func.return
}

// BFP rounding of x and W: tolerance sized for 8-bit mantissas over K = 2048.
check.scenario public @bfp_e_m512_check {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %x = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<2048xbf16>
    %w = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<1048576xbf16>
    %y = check.generate.fill value(0.0) : tensor<512xf32>
    check.compare<@bfp_e_m512, @reference_m512>(%x, %w, %y) : (tensor<2048xbf16>, tensor<1048576xbf16>, tensor<512xf32>) -> () {
      check.expect.approximate actual(%y) expected(%y) atol(0.5) rtol(0.05) nan(same) : tensor<512xf32>, tensor<512xf32>
    }
  }
  check.return
}

check.case public @bfp_e_m8192_case {
  %s7 = check.literal value(7) : i64
  %s8 = check.literal value(8) : i64
  %x = check.generate.random.uniform seed(%s7) range(-1.0 to 1.0) : tensor<2048xbf16>
  %w = check.generate.random.uniform seed(%s8) range(-1.0 to 1.0) : tensor<16777216xbf16>
  %y = check.generate.fill value(0.0) : tensor<8192xf32>
  kernel.launch @bfp_e_m8192(%x, %w, %y) : (tensor<2048xbf16>, tensor<16777216xbf16>, tensor<8192xf32>)
  check.return
}
check.benchmark<@bfp_e_m8192_case> @bfp_e_m8192_time

// Pre-encoded weights; random bytes stand in for encoded tiles (timing only).
check.case public @bfp_p_m8192_case {
  %s7 = check.literal value(7) : i64
  %s8 = check.literal value(8) : i64
  %x = check.generate.random.uniform seed(%s7) range(-1.0 to 1.0) : tensor<2048xbf16>
  %w = check.generate.random.uniform seed(%s8) range(0 to 100) : tensor<18874368xi8>
  %y = check.generate.fill value(0.0) : tensor<8192xf32>
  kernel.launch @bfp_p_m8192(%x, %w, %y) : (tensor<2048xbf16>, tensor<18874368xi8>, tensor<8192xf32>)
  check.return
}
check.benchmark<@bfp_p_m8192_case> @bfp_p_m8192_time

check.case public @bfp_q_m8192_case {
  %s7 = check.literal value(7) : i64
  %s8 = check.literal value(8) : i64
  %x = check.generate.random.uniform seed(%s7) range(-1.0 to 1.0) : tensor<2048xbf16>
  %w = check.generate.random.uniform seed(%s8) range(0 to 100) : tensor<18874368xi8>
  %y = check.generate.fill value(0.0) : tensor<8192xf32>
  kernel.launch @bfp_q_m8192(%x, %w, %y) : (tensor<2048xbf16>, tensor<18874368xi8>, tensor<8192xf32>)
  check.return
}
check.benchmark<@bfp_q_m8192_case> @bfp_q_m8192_time

// Pre-encoded pair layout: record R = 2P + h holds half h of K for groups 2P
// and 2P + 1, tiles interleaved; each tile is 8 rows of [exponent][8 signed
// mantissas], row n = output row 8g + n, value = mantissa * 2^(exponent - 133).
func.def @set_exponents(%w: buffer) {
  %origin = index.constant 0 : offset
  %bytes = buffer.view %w[%origin] : buffer -> view<1179648xi8>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c9 = index.constant 9 : index
  %count = index.constant 131072 : index
  %e = scalar.constant -123 : i8
  scf.for %r = [%c0 to %count step %c1] {
    %at = index.mul %r, %c9 : index
    view.store %e, %bytes[%at] : i8, view<1179648xi8>
  }
  func.return
}

func.def @reference_q_m512(%x: buffer, %w: buffer, %y: buffer) {
  %origin = index.constant 0 : offset
  %xv = buffer.view %x[%origin] : buffer -> view<2048xbf16>
  %bytes = buffer.view %w[%origin] : buffer -> view<1179648xi8>
  %yv = buffer.view %y[%origin] : buffer -> view<512xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c72 = index.constant 72 : index
  %half = index.constant 128 : index
  %tiles = index.constant 256 : index
  %record_bytes = index.constant 18432 : index
  %groups = index.constant 64 : index
  %fzero = scalar.constant 0.0 : f32
  %bias = scalar.constant 133 : i32
  scf.for %g = [%c0 to %groups step %c1] {
    %pair = index.div %g, %c2 : index
    %s = index.rem %g, %c2 : index
    scf.for %n = [%c0 to %c8 step %c1] {
      %sum = scf.for %j = [%c0 to %tiles step %c1](%acc = %fzero : f32) -> (f32) {
        %h = index.div %j, %half : index
        %jl = index.rem %j, %half : index
        %pair2 = index.mul %pair, %c2 : index
        %record = index.add %pair2, %h : index
        %record_at = index.mul %record, %record_bytes : index
        %slot2 = index.mul %jl, %c2 : index
        %slot = index.add %slot2, %s : index
        %slot_at = index.mul %slot, %c72 : index
        %tile_at = index.add %record_at, %slot_at : index
        %row_at = index.mul %n, %c9 : index
        %exp_at = index.add %tile_at, %row_at : index
        %exp_byte = view.load %bytes[%exp_at] : view<1179648xi8> -> i8
        %exponent = scalar.extui %exp_byte : i8 to i32
        %shift = scalar.subi %exponent, %bias : i32
        %inner = scf.for %c = [%c0 to %c8 step %c1](%a = %acc : f32) -> (f32) {
          %m_at1 = index.add %exp_at, %c1 : index
          %m_at = index.add %m_at1, %c : index
          %m_byte = view.load %bytes[%m_at] : view<1179648xi8> -> i8
          %m = scalar.extsi %m_byte : i8 to i32
          %integer = scalar.shli %m, %shift : i32
          %wf = scalar.sitofp %integer : i32 to f32
          %xbase = index.mul %j, %c8 : index
          %xi = index.add %xbase, %c : index
          %xb = view.load %xv[%xi] : view<2048xbf16> -> bf16
          %xf = scalar.extf %xb : bf16 to f32
          %next = scalar.fmaf %xf, %wf, %a : f32
          scf.yield %next : f32
        }
        scf.yield %inner : f32
      }
      %row8 = index.mul %g, %c8 : index
      %row = index.add %row8, %n : index
      view.store %sum, %yv[%row] : f32, view<512xf32>
    }
  }
  func.return
}

check.scenario public @bfp_q_m512_check {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %x = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<2048xbf16>
    %w = check.generate.random.uniform seed(%seed) range(-16 to 16) : tensor<1179648xi8>
    check.generate<@set_exponents>(%w) : (tensor<1179648xi8>) -> ()
    %y = check.generate.fill value(0.0) : tensor<512xf32>
    check.compare<@bfp_q_m512, @reference_q_m512>(%x, %w, %y) : (tensor<2048xbf16>, tensor<1179648xi8>, tensor<512xf32>) -> () {
      check.expect.approximate actual(%y) expected(%y) atol(4.0) rtol(0.02) nan(same) : tensor<512xf32>, tensor<512xf32>
    }
  }
  check.return
}

// Batch of 8: x blocked Xb[j][b][c] = x_b[8j + c]; y blocked Yb[g][b][n] =
// y_b[8g + n]; weights in the single-group packed layout (record R = 2g + h,
// 128 tiles of 8 rows [exponent][8 mantissas]).
func.def @set_exponents_b(%w: buffer) {
  %origin = index.constant 0 : offset
  %bytes = buffer.view %w[%origin] : buffer -> view<1179648xi8>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c9 = index.constant 9 : index
  %count = index.constant 131072 : index
  %e = scalar.constant -123 : i8
  scf.for %r = [%c0 to %count step %c1] {
    %at = index.mul %r, %c9 : index
    view.store %e, %bytes[%at] : i8, view<1179648xi8>
  }
  func.return
}

func.def @reference_b_m512(%x: buffer, %w: buffer, %y: buffer) {
  %origin = index.constant 0 : offset
  %xv = buffer.view %x[%origin] : buffer -> view<256x8x8xbf16>
  %bytes = buffer.view %w[%origin] : buffer -> view<1179648xi8>
  %yv = buffer.view %y[%origin] : buffer -> view<64x8x8xf32>
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c9 = index.constant 9 : index
  %c72 = index.constant 72 : index
  %tiles = index.constant 256 : index
  %group_bytes = index.constant 18432 : index
  %groups = index.constant 64 : index
  %fzero = scalar.constant 0.0 : f32
  %bias = scalar.constant 133 : i32
  scf.for %g = [%c0 to %groups step %c1] {
    scf.for %b = [%c0 to %c8 step %c1] {
      scf.for %n = [%c0 to %c8 step %c1] {
        %sum = scf.for %j = [%c0 to %tiles step %c1](%acc = %fzero : f32) -> (f32) {
          %g_at = index.mul %g, %group_bytes : index
          %j_at = index.mul %j, %c72 : index
          %tile_at = index.add %g_at, %j_at : index
          %row_at = index.mul %n, %c9 : index
          %exp_at = index.add %tile_at, %row_at : index
          %exp_byte = view.load %bytes[%exp_at] : view<1179648xi8> -> i8
          %exponent = scalar.extui %exp_byte : i8 to i32
          %shift = scalar.subi %exponent, %bias : i32
          %inner = scf.for %c = [%c0 to %c8 step %c1](%a = %acc : f32) -> (f32) {
            %m_at1 = index.add %exp_at, %c1 : index
            %m_at = index.add %m_at1, %c : index
            %m_byte = view.load %bytes[%m_at] : view<1179648xi8> -> i8
            %m = scalar.extsi %m_byte : i8 to i32
            %integer = scalar.shli %m, %shift : i32
            %wf = scalar.sitofp %integer : i32 to f32
            %xb = view.load %xv[%j, %b, %c] : view<256x8x8xbf16> -> bf16
            %xf = scalar.extf %xb : bf16 to f32
            %next = scalar.fmaf %xf, %wf, %a : f32
            scf.yield %next : f32
          }
          scf.yield %inner : f32
        }
        view.store %sum, %yv[%g, %b, %n] : f32, view<64x8x8xf32>
      }
    }
  }
  func.return
}

check.scenario public @bfp_b_m512_check {
  check.trial[1](%trial: index, %entropy: check.entropy) {
    %seed = check.entropy.read %entropy[%trial] : check.entropy -> i64
    %x = check.generate.random.uniform seed(%seed) range(-1.0 to 1.0) : tensor<16384xbf16>
    %w = check.generate.random.uniform seed(%seed) range(-16 to 16) : tensor<1179648xi8>
    check.generate<@set_exponents_b>(%w) : (tensor<1179648xi8>) -> ()
    %y = check.generate.fill value(0.0) : tensor<4096xf32>
    check.compare<@bfp_b_m512, @reference_b_m512>(%x, %w, %y) : (tensor<16384xbf16>, tensor<1179648xi8>, tensor<4096xf32>) -> () {
      check.expect.approximate actual(%y) expected(%y) atol(4.0) rtol(0.02) nan(same) : tensor<4096xf32>, tensor<4096xf32>
    }
  }
  check.return
}

check.case public @bfp_b_m8192_case {
  %s7 = check.literal value(7) : i64
  %s8 = check.literal value(8) : i64
  %x = check.generate.random.uniform seed(%s7) range(-1.0 to 1.0) : tensor<16384xbf16>
  %w = check.generate.random.uniform seed(%s8) range(0 to 100) : tensor<18874368xi8>
  %y = check.generate.fill value(0.0) : tensor<65536xf32>
  kernel.launch @bfp_b_m8192(%x, %w, %y) : (tensor<16384xbf16>, tensor<18874368xi8>, tensor<65536xf32>)
  check.return
}
