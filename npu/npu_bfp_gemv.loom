// Generated by gen_bfp.py. LFM3 FFN GEMV (y = W x, K = 2048) on the XDNA NPU
// through AIE2P bfp16ebs8 matrix multiplies: 8-bit mantissas sharing one
// exponent per 8 values (72 bytes per 8 x 8 tile, 1.125 bytes per weight).
// Weights are blocked: Wb[g][j][r][c] = W[8g + r][8j + c].

aie2p.target<array> @npu


func.def inline @record_dot_e(%x: view<2048xbf16>, %row: view<64xbf16>, %w: view<8192xbf16>, %tile0: index, %acc: vector<64xf32>) -> (vector<64xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %c64 = index.constant 64 : index
  %c72 = index.constant 72 : index
  %half = index.constant 128 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %result = scf.for %j = [%c0 to %half step %c1](%a = %acc : vector<64xf32>) -> (vector<64xf32>) {
    %tile = index.add %tile0, %j : index
    %x_at = index.mul %tile, %c8 : index
    %slice = vector.load %x[%x_at] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes = vector.encode %x_values using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %w_at = index.mul %j, %c64 : index
    %w_values = vector.load %w[%w_at] : view<8192xbf16> -> vector<64xbf16>
    %w_bytes = vector.encode %w_values using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs = vector.fragment<lhs> %x_bytes shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %rhs = vector.fragment<rhs> %w_bytes shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %next = vector.mma %lhs, %rhs, %a : vector<72xi8>, vector<72xi8>, vector<64xf32>
    scf.yield %next : vector<64xf32>
  }
  func.return %result : vector<64xf32>
}

func.def inline @record_dot_p(%x: view<2048xbf16>, %row: view<64xbf16>, %w: view<9216xi8>, %tile0: index, %acc: vector<64xf32>) -> (vector<64xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %cper = index.constant 8 : index
  %cbytes = index.constant 576 : index
  %chunks = index.constant 16 : index
  %c0_x = index.constant 0 : index
  %c8_x = index.constant 8 : index
  %c16_x = index.constant 16 : index
  %c24_x = index.constant 24 : index
  %c32_x = index.constant 32 : index
  %c40_x = index.constant 40 : index
  %c48_x = index.constant 48 : index
  %c56_x = index.constant 56 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %result = scf.for %chunk = [%c0 to %chunks step %c1](%a0 = %acc : vector<64xf32>) -> (vector<64xf32>) {
    %w_at = index.mul %chunk, %cbytes : index
    %w_group = vector.load %w[%w_at] : view<9216xi8> -> vector<576xi8>
    %w_blocks = vector.fragment<rhs> %w_group shape [blocks(%cper), %c8, %c8] using {schema = %schema : encoding<schema>} : vector<576xi8>
    %tile_in = index.mul %chunk, %cper : index
    %tile = index.add %tile0, %tile_in : index
    %x_base = index.mul %tile, %c8 : index
    %x_at0 = index.add %x_base, %c0_x : index
    %slice0 = vector.load %x[%x_at0] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice0, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values0 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes0 = vector.encode %x_values0 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs0 = vector.fragment<lhs> %x_bytes0 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes0 = vector.slice %w_blocks[0] : vector<576xi8> -> vector<72xi8>
    %rhs0 = vector.fragment<rhs> %w_bytes0 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a1 = vector.mma %lhs0, %rhs0, %a0 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at1 = index.add %x_base, %c8_x : index
    %slice1 = vector.load %x[%x_at1] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice1, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values1 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes1 = vector.encode %x_values1 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs1 = vector.fragment<lhs> %x_bytes1 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes1 = vector.slice %w_blocks[72] : vector<576xi8> -> vector<72xi8>
    %rhs1 = vector.fragment<rhs> %w_bytes1 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a2 = vector.mma %lhs1, %rhs1, %a1 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at2 = index.add %x_base, %c16_x : index
    %slice2 = vector.load %x[%x_at2] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice2, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values2 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes2 = vector.encode %x_values2 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs2 = vector.fragment<lhs> %x_bytes2 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes2 = vector.slice %w_blocks[144] : vector<576xi8> -> vector<72xi8>
    %rhs2 = vector.fragment<rhs> %w_bytes2 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a3 = vector.mma %lhs2, %rhs2, %a2 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at3 = index.add %x_base, %c24_x : index
    %slice3 = vector.load %x[%x_at3] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice3, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values3 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes3 = vector.encode %x_values3 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs3 = vector.fragment<lhs> %x_bytes3 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes3 = vector.slice %w_blocks[216] : vector<576xi8> -> vector<72xi8>
    %rhs3 = vector.fragment<rhs> %w_bytes3 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a4 = vector.mma %lhs3, %rhs3, %a3 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at4 = index.add %x_base, %c32_x : index
    %slice4 = vector.load %x[%x_at4] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice4, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values4 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes4 = vector.encode %x_values4 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs4 = vector.fragment<lhs> %x_bytes4 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes4 = vector.slice %w_blocks[288] : vector<576xi8> -> vector<72xi8>
    %rhs4 = vector.fragment<rhs> %w_bytes4 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a5 = vector.mma %lhs4, %rhs4, %a4 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at5 = index.add %x_base, %c40_x : index
    %slice5 = vector.load %x[%x_at5] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice5, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values5 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes5 = vector.encode %x_values5 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs5 = vector.fragment<lhs> %x_bytes5 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes5 = vector.slice %w_blocks[360] : vector<576xi8> -> vector<72xi8>
    %rhs5 = vector.fragment<rhs> %w_bytes5 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a6 = vector.mma %lhs5, %rhs5, %a5 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at6 = index.add %x_base, %c48_x : index
    %slice6 = vector.load %x[%x_at6] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice6, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values6 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes6 = vector.encode %x_values6 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs6 = vector.fragment<lhs> %x_bytes6 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes6 = vector.slice %w_blocks[432] : vector<576xi8> -> vector<72xi8>
    %rhs6 = vector.fragment<rhs> %w_bytes6 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a7 = vector.mma %lhs6, %rhs6, %a6 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at7 = index.add %x_base, %c56_x : index
    %slice7 = vector.load %x[%x_at7] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice7, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values7 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes7 = vector.encode %x_values7 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs7 = vector.fragment<lhs> %x_bytes7 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %w_bytes7 = vector.slice %w_blocks[504] : vector<576xi8> -> vector<72xi8>
    %rhs7 = vector.fragment<rhs> %w_bytes7 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a8 = vector.mma %lhs7, %rhs7, %a7 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    scf.yield %a8 : vector<64xf32>
  }
  func.return %result : vector<64xf32>
}

func.def inline @record_dot_pair(%x: view<2048xbf16>, %row: view<64xbf16>, %w: view<18432xi8>, %tile0: index, %acc: vector<64xf32>, %bcc: vector<64xf32>) -> (vector<64xf32>, vector<64xf32>) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c8 = index.constant 8 : index
  %cper = index.constant 4 : index
  %cpairs = index.constant 8 : index
  %cbytes = index.constant 576 : index
  %chunks = index.constant 32 : index
  %c0_x = index.constant 0 : index
  %c8_x = index.constant 8 : index
  %c16_x = index.constant 16 : index
  %c24_x = index.constant 24 : index
  %schema = encoding.define #encoding.operand<element_format=bfp16ebs8, payload_elements=64, payload_packing=target_fragment, payload_registers=18, rounding=flush_subnormal> : encoding<schema>
  %ra, %rb = scf.for %chunk = [%c0 to %chunks step %c1](%a0 = %acc : vector<64xf32>, %b0 = %bcc : vector<64xf32>) -> (vector<64xf32>, vector<64xf32>) {
    %w_at = index.mul %chunk, %cbytes : index
    %group = vector.load %w[%w_at] : view<18432xi8> -> vector<576xi8>
    %blocks = vector.fragment<rhs> %group shape [blocks(%cpairs), %c8, %c8] using {schema = %schema : encoding<schema>} : vector<576xi8>
    %tile_in = index.mul %chunk, %cper : index
    %tile = index.add %tile0, %tile_in : index
    %x_base = index.mul %tile, %c8 : index
    %x_at0 = index.add %x_base, %c0_x : index
    %slice0 = vector.load %x[%x_at0] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice0, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values0 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes0 = vector.encode %x_values0 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs0 = vector.fragment<lhs> %x_bytes0 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %u_bytes0 = vector.slice %blocks[0] : vector<576xi8> -> vector<72xi8>
    %u_rhs0 = vector.fragment<rhs> %u_bytes0 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a1 = vector.mma %lhs0, %u_rhs0, %a0 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %v_bytes0 = vector.slice %blocks[72] : vector<576xi8> -> vector<72xi8>
    %v_rhs0 = vector.fragment<rhs> %v_bytes0 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %b1 = vector.mma %lhs0, %v_rhs0, %b0 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at1 = index.add %x_base, %c8_x : index
    %slice1 = vector.load %x[%x_at1] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice1, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values1 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes1 = vector.encode %x_values1 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs1 = vector.fragment<lhs> %x_bytes1 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %u_bytes1 = vector.slice %blocks[144] : vector<576xi8> -> vector<72xi8>
    %u_rhs1 = vector.fragment<rhs> %u_bytes1 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a2 = vector.mma %lhs1, %u_rhs1, %a1 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %v_bytes1 = vector.slice %blocks[216] : vector<576xi8> -> vector<72xi8>
    %v_rhs1 = vector.fragment<rhs> %v_bytes1 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %b2 = vector.mma %lhs1, %v_rhs1, %b1 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at2 = index.add %x_base, %c16_x : index
    %slice2 = vector.load %x[%x_at2] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice2, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values2 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes2 = vector.encode %x_values2 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs2 = vector.fragment<lhs> %x_bytes2 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %u_bytes2 = vector.slice %blocks[288] : vector<576xi8> -> vector<72xi8>
    %u_rhs2 = vector.fragment<rhs> %u_bytes2 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a3 = vector.mma %lhs2, %u_rhs2, %a2 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %v_bytes2 = vector.slice %blocks[360] : vector<576xi8> -> vector<72xi8>
    %v_rhs2 = vector.fragment<rhs> %v_bytes2 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %b3 = vector.mma %lhs2, %v_rhs2, %b2 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %x_at3 = index.add %x_base, %c24_x : index
    %slice3 = vector.load %x[%x_at3] : view<2048xbf16> -> vector<8xbf16>
    vector.store %slice3, %row[0] : vector<8xbf16>, view<64xbf16>
    %x_values3 = vector.load %row[0] : view<64xbf16> -> vector<64xbf16>
    %x_bytes3 = vector.encode %x_values3 using %schema : vector<64xbf16>, encoding<schema> -> vector<72xi8>
    %lhs3 = vector.fragment<lhs> %x_bytes3 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %u_bytes3 = vector.slice %blocks[432] : vector<576xi8> -> vector<72xi8>
    %u_rhs3 = vector.fragment<rhs> %u_bytes3 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %a4 = vector.mma %lhs3, %u_rhs3, %a3 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    %v_bytes3 = vector.slice %blocks[504] : vector<576xi8> -> vector<72xi8>
    %v_rhs3 = vector.fragment<rhs> %v_bytes3 shape [%c8, %c8] using {schema = %schema : encoding<schema>} : vector<72xi8>
    %b4 = vector.mma %lhs3, %v_rhs3, %b3 : vector<72xi8>, vector<72xi8>, vector<64xf32>
    scf.yield %a4, %b4 : vector<64xf32>, vector<64xf32>
  }
  func.return %ra, %rb : vector<64xf32>, vector<64xf32>
}

// One column: ingress [c, 2] streams records (half a group: 128 tiles), compute
// [c, 3] multiplies, egress [c, 4] drains 8 outputs per group.
pipeline.def<kernel> @bfp_e_col(%groups: index, %column: index) run(%x_arg: buffer, %w_arg: buffer, %y_arg: buffer) {
  %x_unique, %w_unique, %y_unique = buffer.assume.noalias %x_arg, %w_arg, %y_arg : buffer, buffer, buffer
  %x_buf, %w_buf, %y_buf = buffer.assume.alignment %x_unique, %w_unique, %y_unique {minimum_alignment = 64} : buffer, buffer, buffer
  %origin = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c32 = index.constant 32 : index
  %record_bytes = index.constant 16384 : index
  %records = index.mul %groups, %c2 : index
  %first_group = index.mul %column, %groups : index
  %first_record = index.mul %first_group, %c2 : index
  %memory = pipeline.memory<workgroup>[%column, 3] : pool
  %x_size = index.constant 4096 : offset
  %x_storage = buffer.alloca<workgroup> pool(%memory) align(64) %x_size : buffer
  %x_slots = buffer.view %x_storage[%origin] : buffer -> view<1x2048xbf16>
  %x_channel = channel.bind<fifo> %x_slots, %c1 : view<1x2048xbf16>, index -> channel<tile<2048xbf16>>
  %ring_size = index.constant 32768 : offset
  %w_storage = buffer.alloca<workgroup> pool(%memory) align(64) %ring_size : buffer
  %w_slots = buffer.view %w_storage[%origin] : buffer -> view<2x8192xbf16>
  %w_channel = channel.bind<fifo> %w_slots, %c2 : view<2x8192xbf16>, index -> channel<tile<8192xbf16>>
  %y_size = index.constant 64 : offset
  %y_storage = buffer.alloca<workgroup> pool(%memory) align(64) %y_size : buffer
  %y_slots = buffer.view %y_storage[%origin] : buffer -> view<2x8xf32>
  %y_channel = channel.bind<fifo> %y_slots, %c2 : view<2x8xf32>, index -> channel<tile<8xf32>>

  pipeline.strand workers([%column, 2], [1, 1], [1, 1]) {
    %x_external = buffer.view %x_buf[%origin] : buffer -> view<2048xbf16>
    %x_write, %x_payload = channel.reserve %x_channel : channel<tile<2048xbf16>> -> (write<tile<2048xbf16>>, view<2048xbf16>)
    %x_copy = kernel.async.copy %x_external to %x_payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<2048xbf16> to view<2048xbf16> -> kernel.async.token
    %x_group = kernel.async.group %x_copy : kernel.async.token -> kernel.async.group
    kernel.async.wait %x_group {newer_groups = 0} : kernel.async.group
    channel.publish %x_write : write<tile<2048xbf16>>
    scf.for %record = [%c0 to %records step %c1] {
      %global = index.add %first_record, %record : index
      %byte_index = index.mul %global, %record_bytes : index
      %offset = index.cast %byte_index : index to offset
      %external = buffer.view %w_buf[%offset] : buffer -> view<8192xbf16>
      %write, %payload = channel.reserve %w_channel : channel<tile<8192xbf16>> -> (write<tile<8192xbf16>>, view<8192xbf16>)
      %copy = kernel.async.copy %external to %payload {cache_scope = workgroup, cache_temporal = regular, direction = global_to_workgroup} : view<8192xbf16> to view<8192xbf16> -> kernel.async.token
      %group = kernel.async.group %copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %group {newer_groups = 0} : kernel.async.group
      channel.publish %write : write<tile<8192xbf16>>
    }
  }

  pipeline.strand workers([%column, 4], [1, 1], [1, 1]) {
    scf.for %g = [%c0 to %groups step %c1] {
      %read, %payload = channel.acquire %y_channel : channel<tile<8xf32>> -> (read<tile<8xf32>>, view<8xf32>)
      %global = index.add %first_group, %g : index
      %out_index = index.mul %global, %c32 : index
      %out_offset = index.cast %out_index : index to offset
      %y_external = buffer.view %y_buf[%out_offset] : buffer -> view<8xf32>
      %y_copy = kernel.async.copy %payload to %y_external {cache_scope = workgroup, cache_temporal = regular, direction = workgroup_to_global} : view<8xf32> to view<8xf32> -> kernel.async.token
      %y_group = kernel.async.group %y_copy : kernel.async.token -> kernel.async.group
      kernel.async.wait %y_group {newer_groups = 0} : kernel.async.group
      channel.release %read : read<tile<8xf32>>
    }
  }

  pipeline.strand workers([%column, 3], [1, 1], [1, 1]) {
    %base = index.constant 0 : offset
    %c8 = index.constant 8 : index
    %half = index.constant 128 : index
    %row_size = index.constant 128 : offset
    %row_storage = buffer.alloca<private> align(64) %row_size : buffer
